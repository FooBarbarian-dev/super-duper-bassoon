cabal-version:      3.0
name:               llm-patterns
version:            0.1.0.0
synopsis:           Ergonomic orchestration patterns for LLMs in Haskell
description:
  A library providing composable orchestration patterns for Large Language Models,
  including sequential, concurrent, group chat, handoff, and magentic patterns.
  Built on top of the langchain-hs framework.
license:            MIT
license-file:       LICENSE
author:             Your Name
maintainer:         you@example.com
category:           AI, Machine Learning
build-type:         Simple
extra-source-files: README.md

common shared-properties
  default-language:   Haskell2010
  ghc-options:        -Wall
                      -Wcompat
                      -Widentities
                      -Wincomplete-record-updates
                      -Wincomplete-uni-patterns
                      -Wmissing-home-modules
                      -Wpartial-fields
                      -Wredundant-constraints
  default-extensions: OverloadedStrings

library
  import:           shared-properties
  exposed-modules:
    LLMPatterns
    LLMPatterns.Types
    LLMPatterns.Agent
    LLMPatterns.Orchestrator
    LLMPatterns.Config
    LLMPatterns.Patterns.Sequential
    LLMPatterns.Patterns.Concurrent
    LLMPatterns.Patterns.GroupChat
    LLMPatterns.Patterns.Handoff
    LLMPatterns.Patterns.Magentic

  build-depends:
    base              >= 4.14 && < 5,
    langchain-hs      >= 0.0.1,
    text              >= 1.2,
    time              >= 1.9,
    async             >= 2.2,
    aeson             >= 2.0,
    yaml              >= 0.11,
    containers        >= 0.6,
    mtl               >= 2.2,
    transformers      >= 0.5

  hs-source-dirs:     src

-- Example executables
executable basic-usage
  import:           shared-properties
  main-is:          BasicUsage.hs
  build-depends:
    base >= 4.14 && < 5,
    llm-patterns,
    text >= 1.2
  hs-source-dirs:   examples
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

executable yaml-config
  import:           shared-properties
  main-is:          YamlConfig.hs
  build-depends:
    base >= 4.14 && < 5,
    llm-patterns,
    text >= 1.2
  hs-source-dirs:   examples
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

executable pattern-comparison
  import:           shared-properties
  main-is:          PatternComparison.hs
  build-depends:
    base >= 4.14 && < 5,
    llm-patterns,
    text >= 1.2
  hs-source-dirs:   examples
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
