packages:
  llm-patterns/
  llm-patterns-ui/

-- Resolver for dependencies
index-state: 2024-01-01T00:00:00Z

-- Common flags
package *
  ghc-options: -Wall

-- Development settings
optimization: True

-- You may need to add source-repository-package for langchain-hs
-- if it's not on Hackage yet
source-repository-package
  type: git
  location: https://github.com/example/langchain-hs.git
  tag: main
