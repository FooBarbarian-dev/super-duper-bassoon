packages:
  ./llm-patterns/
  ./llm-patterns-ui/

-- Resolver for dependencies
-- index-state: 2024-01-01T00:00:00Z

-- Common flags
package *
  ghc-options: -Wall

-- Development settings
optimization: True

-- Note: langchain-hs is stubbed locally in llm-patterns/src/Langchain/
-- for testing and compilation. To use a real LLM backend, replace the stub
-- with actual langchain-hs integration.
