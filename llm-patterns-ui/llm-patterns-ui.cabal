cabal-version:      3.0
name:               llm-patterns-ui
version:            0.1.0.0
synopsis:           Web UI for LLM orchestration patterns
description:
  A web application for demonstrating and comparing different LLM orchestration
  patterns, built with Servant and the llm-patterns library.
license:            MIT
license-file:       LICENSE
author:             Your Name
maintainer:         you@example.com
category:           Web, AI
build-type:         Simple
extra-source-files: README.md
                    static/index.html
                    static/styles.css
                    static/app.js

common shared-properties
  default-language:   Haskell2010
  ghc-options:        -Wall
                      -Wcompat
                      -Widentities
                      -Wincomplete-record-updates
                      -Wincomplete-uni-patterns
                      -Wmissing-home-modules
                      -Wpartial-fields
                      -Wredundant-constraints
  default-extensions: OverloadedStrings

executable llm-patterns-ui
  import:           shared-properties
  main-is:          Main.hs
  other-modules:
    API
    Server

  build-depends:
    base              >= 4.14 && < 5,
    llm-patterns,
    servant           >= 0.19,
    servant-server    >= 0.19,
    servant-websockets >= 2.0,
    warp              >= 3.3,
    wai               >= 3.2,
    wai-app-static    >= 3.1,
    aeson             >= 2.0,
    text              >= 1.2,
    time              >= 1.9,
    websockets        >= 0.12,
    mtl               >= 2.2,
    transformers      >= 0.5,
    fast-logger       >= 3.0,
    bytestring        >= 0.10

  hs-source-dirs:     src
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N
